# Copy this file to .env for local development.
# Fill values locally only; never commit real secrets.

# ---- App ----
ENVIRONMENT=development
API_PORT=8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ---- Supabase ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# ---- Auth (demo login issues app JWTs)
JWT_SECRET=dev-insecure-secret-change-me
# Comma-separated emails that may call admin routes (Simulate, resolve, etc.)
# Log in via POST /auth/demo with one of these emails to get admin.
ADMIN_EMAILS=
# Optional Google OAuth (GIS id_token → POST /auth/google)
# In Google Cloud Console → Credentials → your OAuth client:
#   Authorized JavaScript origins must include your Vite dev URL, e.g.
#   http://localhost:5173 (default strictPort in vite.config.ts)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ---- Gemini (server-side only) ----
GEMINI_API_KEY=

# ---- Frontend (Vite, VITE_ prefix is exposed to the browser) ----
# Vite loads this file from the repo root (frontend/vite.config.ts envDir: "..").
VITE_API_BASE_URL=http://localhost:8000
# Must match GOOGLE_CLIENT_ID (safe to expose — public OAuth client id)
VITE_GOOGLE_CLIENT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Railway (production) ----
# Two services: API (root /) and Frontend (root /frontend). See docs/RAILWAY.md.
#
# API service env (set in Railway dashboard — do not commit real values):
#   DATABASE_URL=
#   JWT_SECRET=
#   ADMIN_EMAILS=
#   GEMINI_API_KEY=
#   GOOGLE_CLIENT_ID=
#   GOOGLE_CLIENT_SECRET=
#
# Frontend service build env (Vite bakes these in — redeploy after changing):
#   VITE_API_BASE_URL=https://${{API.RAILWAY_PUBLIC_DOMAIN}}
#   VITE_GOOGLE_CLIENT_ID=
#   VITE_SUPABASE_URL=
#   VITE_SUPABASE_ANON_KEY=
#
# Deploy API first, generate its domain, set VITE_API_BASE_URL, then rebuild Frontend.
# Add the Frontend public origin to Google OAuth Authorized JavaScript origins.
